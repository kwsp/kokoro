{
  "name": "kokoro-firefox-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests/unit scripts",
    "format": "prettier --write src tests/unit scripts *.json *.mjs",
    "format:check": "prettier --check src tests/unit scripts *.json *.mjs",
    "test": "vitest run",
    "lint:extension": "web-ext lint --source-dir dist --warnings-as-errors --ignore-files Readability.js",
    "package": "npm run build && web-ext build --source-dir dist --artifacts-dir artifacts --overwrite-dest",
    "dev": "npm run build && web-ext run --source-dir dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/firefox-webext-browser": "^120.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.25.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0"
  }
}
