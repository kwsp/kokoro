{
  "manifest_version": 2,
  "name": "Kokoro Page Reader",
  "version": "0.1.0",
  "description": "Read webpage text with a local Kokoro speech server.",
  "permissions": [
    "activeTab",
    "storage",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Read with Kokoro",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "icons": {
    "48": "icon.png",
    "96": "icon.png"
  }
}
